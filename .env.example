# ---- app ----
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
SERVER_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- database ----
DATABASE_URL="mysql://root:password@localhost:3306/method-commerce"

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d
JWT_ADMIN_ACCESS_TTL=12h

# ---- otp (stored in Redis; default 2 minutes) ----
OTP_LENGTH=5
OTP_TTL_SECONDS=120
# expose the generated otp in the API response (development only)
OTP_EXPOSE_IN_RESPONSE=true

# ---- redis (OTP TTL + BullMQ unpaid-order cancel) ----
REDIS_URL=redis://127.0.0.1:6379
# set REDIS_ENABLED=false to use in-memory OTP + skip BullMQ (CI/local without Redis)
# REDIS_ENABLED=true

# Product search. Without MEILISEARCH_URL products are searched in memory
# (fine for development and small stores). docker-compose starts Meilisearch.
# MEILISEARCH_URL=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=change-me-master-key
# MEILISEARCH_INDEX=products
# Rebuild the index on start-up, and every N minutes as a safety net (0 = never).
SEARCH_REINDEX_ON_BOOT=true
SEARCH_REFRESH_MINUTES=15
#
# npm test  → in-memory fakes (no Redis)
# npm run redis:up && npm run test:redis  → live Redis + BullMQ (OTP TTL + 10s unpaid cancel)

# ---- unpaid ONLINE order auto-cancel (BullMQ delayed job) ----
ORDER_UNPAID_CANCEL_DELAY_MS=900000

# ---- sms ----
# console | kavenegar
SMS_DRIVER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# ---- mail (admin password reset) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="method-commerce <no-reply@example.com>"

# ---- password reset ----
PASSWORD_RESET_TTL_SECONDS=600

# ---- logging ----
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_DIR=logs

# ---- uploads ----
# Images (except GIFs) are re-encoded as WebP and scaled to fit this many pixels.
UPLOAD_MAX_IMAGE_DIMENSION=1600
UPLOAD_WEBP_QUALITY=82

# ---- storage: disk (default, uploads/ served by this API) | s3 ----
# s3 works with AWS, ArvanCloud, Liara and MinIO; use it when more than one API
# instance runs, and put a CDN in front of the bucket.
STORAGE_DRIVER=disk
# Local MinIO: docker compose --profile s3 up -d minio minio-init
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=method-commerce
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_OBJECT_ACL=
# Public URL for stored files: the bucket URL or your CDN, no trailing slash.
# S3_PUBLIC_BASE_URL=http://localhost:9000/method-commerce
