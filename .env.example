# ---- app ----
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
SERVER_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- database ----
DATABASE_URL="mysql://root:password@localhost:3306/method-commerce"

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d
JWT_ADMIN_ACCESS_TTL=12h

# ---- otp (stored in Redis; default 2 minutes) ----
OTP_LENGTH=5
OTP_TTL_SECONDS=120
# expose the generated otp in the API response (development only)
OTP_EXPOSE_IN_RESPONSE=true

# ---- redis (OTP TTL + BullMQ unpaid-order cancel) ----
REDIS_URL=redis://127.0.0.1:6379
# set REDIS_ENABLED=false to use in-memory OTP + skip BullMQ (CI/local without Redis)
# REDIS_ENABLED=true
#
# npm test  → in-memory fakes (no Redis)
# npm run redis:up && npm run test:redis  → live Redis + BullMQ (OTP TTL + 10s unpaid cancel)

# ---- unpaid ONLINE order auto-cancel (BullMQ delayed job) ----
ORDER_UNPAID_CANCEL_DELAY_MS=900000

# ---- sms ----
# console | kavenegar
SMS_DRIVER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# ---- mail (admin password reset) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="method-commerce <no-reply@example.com>"

# ---- password reset ----
PASSWORD_RESET_TTL_SECONDS=600

# ---- logging ----
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_DIR=logs
