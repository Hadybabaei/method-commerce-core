// method-commerce API - Prisma schema.
//
// Table and column names intentionally mirror the legacy method-commerce database so this
// service can run against the same MySQL instance. Only the slice of the schema
// owned by the identity and addressing modules lives here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  HOQOOQI
  HAGHIGHI
  NORMAL
}

model user {
  id             Int       @id @default(autoincrement())
  phone_number   String    @unique
  auth_level     Int       @default(0)
  email          String?
  refresh_token  String?   @db.Text
  otp_code       String?
  otp_expiry     DateTime?
  account_status Boolean?
  /// Set when an admin blocks the customer; blocked customers cannot sign in or order.
  blocked_at     DateTime?
  type           UserType  @default(NORMAL)
  avatar         String?
  role           String    @default("user")
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt

  profile       user_profile?
  userAddresses user_address[]
  favorites     user_favorite[]
  comments      comment[]
  basket        basket?
  orders        order[]
  notifications notification[]
  stockAlerts   stock_alert[]

  @@index(fields: [id, phone_number])
}

model user_profile {
  id               Int      @id @default(autoincrement())
  first_name       String?
  last_name        String?
  father_name      String?
  national_id      String?
  birth_date       String?
  register_code    Int?
  business_role_id Int?
  company_name     String?
  phone            String?
  role_id          Int?
  tax_id           Int?
  userId           Int?     @unique
  user             user?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at       DateTime @default(now())
}

model admin {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  role                 String    @default("operator")
  /// Permission keys this admin holds; the "admin" role (super admin) has all of them.
  permissions          Json?
  status               Boolean   @default(true)
  first_name           String?
  last_name            String?
  nationalId           String?
  address              String?
  avatarUrl            String?
  reset_password_token String?
  reset_token_expire   DateTime?
  phone_number         String?
  created_at           DateTime  @default(now())

  comments      comment[]
  auditLogs     admin_audit_log[]
  notifications notification[]
}

model province {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String
  tel_prefix  String
  cities      city[]
  userAddress user_address[]
}

model city {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String
  province_id Int
  province    province       @relation(fields: [province_id], references: [id], onDelete: Cascade)
  userAddress user_address[]
}

model user_address {
  id                  Int      @id @default(autoincrement())
  title               String
  userId              Int
  user                user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  province_id         Int
  province            province @relation(fields: [province_id], references: [id], onDelete: Cascade)
  city_id             Int
  city                city     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  hood                String
  lat                 Float?
  long                Float?
  postalCode          String
  pelak               String
  vahed               String?
  details             String   @db.Text
  ownReceiver         Boolean
  receiverFullName    String?
  receiverPhoneNumber String?

  @@index(fields: [userId])
}

// ---------------------------------------------------------------------------
// Catalog
//
// `category`, `brand` and `product` keep the legacy column names so existing
// rows can be migrated across as they are. The variant side is a redesign and
// is NOT compatible with the legacy `product_variant` table: variants are now
// defined by their option values rather than by a colour and a warehouse, and
// stock moved out of the catalog into `inventory_level`.
// ---------------------------------------------------------------------------

model category {
  id              Int     @id @default(autoincrement())
  title           String
  slug            String  @unique
  icon            String?
  description     String? @db.Text
  /// Search-engine title and description; null falls back to the title and description.
  seo_title       String? @db.VarChar(120)
  seo_description String? @db.VarChar(320)

  parentId Int?
  parent   category?  @relation("CategorySelfRef", fields: [parentId], references: [id])
  children category[] @relation("CategorySelfRef")

  /// Materialized path of ancestor ids, e.g. "/1/7/12/". Lets a subtree be
  /// fetched with one indexed prefix match instead of a query per level.
  path     String @db.VarChar(255)
  /// Number of ancestors; a root category is 0.
  depth    Int    @default(0)
  /// Sort order among siblings.
  position Int    @default(0)

  products   product[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([path])
  @@index([parentId, position])
}

model brand {
  id              Int     @id @default(autoincrement())
  title           String
  slug            String  @unique
  logo            String?
  description     String? @db.Text
  /// Search-engine title and description; null falls back to the title and description.
  seo_title       String? @db.VarChar(120)
  seo_description String? @db.VarChar(320)

  products   product[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model product {
  id                Int     @id @default(autoincrement())
  title             String
  sub_title         String?
  slug              String  @unique
  description       String? @db.Text
  /// Search-engine title and description; null falls back to the title and description.
  seo_title         String? @db.VarChar(120)
  seo_description   String? @db.VarChar(320)
  short_description String? @db.Text
  publish           Boolean @default(true)
  weightGrams       Int     @default(500)
  /// Exempt goods carry no VAT (e.g. some basic foods and medicine).
  tax_exempt        Boolean @default(false)

  categoryId Int?
  category   category? @relation(fields: [categoryId], references: [id])
  brandId    Int?
  brand      brand?    @relation(fields: [brandId], references: [id])

  images    product_image[]
  options   product_option[]
  variants  product_variant[]
  favorites user_favorite[]
  comments  comment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([categoryId, publish])
  @@index([brandId, publish])
}

/// A customer's saved product. Legacy favourites pointed at a variant; here the
/// unit is the product, because variants are not yet a customer-facing concept
/// and a wishlist is usually about the item, not a specific option combo.
model user_favorite {
  id        Int  @id @default(autoincrement())
  userId    Int
  productId Int
  /// The size, colour, etc. the customer had chosen; null = the product in general.
  variantId Int?

  user    user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant product_variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, created_at])
}

model product_image {
  id        Int     @id @default(autoincrement())
  productId Int
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  thumbnail Boolean @default(false)
  position  Int     @default(0)

  @@index([productId, position])
}

/// An axis a product varies on: colour, size, capacity. Declared per product so
/// every variant carries exactly one value for each of them.
model product_option {
  id        Int     @id @default(autoincrement())
  productId Int
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)

  values product_option_value[]

  @@unique([productId, name])
}

model product_option_value {
  id       Int            @id @default(autoincrement())
  optionId Int
  option   product_option @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int            @default(0)

  variants variant_option_value[]

  @@unique([optionId, value])
}

/// A sellable unit. Its option values are the natural key; `option_signature`
/// is their normalized form so the database can reject a duplicate combination
/// that a join table alone could not.
model product_variant {
  id               Int     @id @default(autoincrement())
  productId        Int
  product          product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String  @unique
  option_signature String  @db.VarChar(255)

  /// Smallest currency unit. Never a float.
  price      Int
  /// Set only while the variant is genuinely on sale; always below `price`.
  sale_price Int?

  weightGrams         Int?
  image               String? @db.Text
  is_active           Boolean @default(true)
  /// Alert when units available across warehouses fall to this number; null = no alert.
  low_stock_threshold Int?

  optionValues   variant_option_value[]
  inventory      inventory_level[]
  basketItems    basket_item[]
  orderItems     order_item[]
  stockMovements stock_movement[]
  favorites      user_favorite[]
  stockAlerts    stock_alert[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([productId, option_signature])
  @@index([productId, is_active])
}

model variant_option_value {
  variantId     Int
  variant       product_variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId Int
  optionValue   product_option_value @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

/// A warehouse or shop. Replaces the legacy `stock` table, which was part of a
/// variant's identity instead of being a place a variant is stored.
model inventory_location {
  id        Int     @id @default(autoincrement())
  name      String
  code      String  @unique
  is_active Boolean @default(true)

  levels inventory_level[]
}

/// How much of one variant sits in one location. `reserved` is held for orders
/// that are placed but not yet fulfilled, so availability is on_hand - reserved.
model inventory_level {
  variantId  Int
  variant    product_variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId Int
  location   inventory_location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  on_hand    Int                @default(0)
  reserved   Int                @default(0)

  updated_at DateTime @updatedAt

  @@id([variantId, locationId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Basket
//
// One open cart per customer. Lines point at variants (the sellable unit), so
// checkout can copy them into an order without re-resolving options. Stock is
// checked when quantities change; reservation happens later at order time.
// ---------------------------------------------------------------------------

model basket {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   user @relation(fields: [userId], references: [id], onDelete: Cascade)

  items basket_item[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model basket_item {
  basketId  Int
  basket    basket          @relation(fields: [basketId], references: [id], onDelete: Cascade)
  variantId Int
  variant   product_variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@id([basketId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Orders
//
// Cut from the customer's basket at checkout. Line prices and product details
// are snapshotted so later catalog edits do not rewrite history. Stock is
// reserved on create (`inventory_level.reserved`), released on cancel, and
// consumed (on_hand + reserved down) when an online payment succeeds.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  CANCELLED
  COMPLETED
}

enum OrderReservationStatus {
  NONE
  RESERVED
  RELEASED
  CONSUMED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
}

model order {
  id     Int    @id @default(autoincrement())
  /// Human-facing code, e.g. ORD-20260911-00042.
  number String @unique

  userId Int
  user   user @relation(fields: [userId], references: [id], onDelete: Restrict)

  status            OrderStatus            @default(PENDING)
  reservationStatus OrderReservationStatus @default(NONE)
  paymentMethod     PaymentMethod          @default(CASH_ON_DELIVERY)

  itemCount Int
  /// Sum of line totals at checkout, in Rial.
  subtotal  Int

  /// Frozen copy of the delivery address at checkout time.
  addressSnapshot Json
  note            String? @db.Text

  /// Per-location stock holds so cancel can release exactly what was reserved.
  stockAllocations Json?

  /// Null when the store had no shipping methods configured at checkout.
  shippingMethodId  Int?
  shippingMethod    shipping_method? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  /// Frozen copy of the chosen method (name, delivery days, tracking URL template).
  shippingSnapshot  Json?
  /// Shipping charge in Rial, fixed at checkout.
  shippingFee       Int              @default(0)
  /// subtotal + shippingFee, in Rial. This is what the customer pays.
  total             Int              @default(0)
  /// Parcel weight used for the shipping quote.
  weightGrams       Int              @default(0)
  trackingCode      String?          @db.VarChar(100)
  trackingUrl       String?          @db.Text
  /// VAT rate at checkout in basis points (1000 = 10%).
  taxRateBp         Int              @default(0)
  /// Sum of line VAT in Rial. total = subtotal + shippingFee + taxTotal.
  taxTotal          Int              @default(0)
  /// Discount in Rial across goods and shipping. total = subtotal + shippingFee - discountTotal + taxTotal.
  discountTotal     Int              @default(0)
  promotionId       Int?
  promotion         promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// Frozen copy of the applied promotion (name, code, kind, value).
  promotionSnapshot Json?
  /// Sum of recorded refunds in Rial; never above total.
  refundedTotal     Int              @default(0)

  items          order_item[]
  payments       payment[]
  statusHistory  order_status_event[]
  returnRequests return_request[]
  refunds        refund[]
  redemption     promotion_redemption?

  cancelledAt  DateTime?
  paidAt       DateTime?
  processingAt DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([userId, created_at])
  @@index([status, created_at])
  @@index([created_at])
}

model order_item {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Kept for reporting; null if the catalog variant is later deleted.
  variantId Int?
  variant   product_variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity  Int
  unitPrice Int
  lineTotal Int

  /// Immutable product/variant display payload from checkout.
  productSnapshot Json
  /// Share of the order discount on this line, in Rial. VAT is charged on lineTotal - discountAmount.
  discountAmount  Int  @default(0)
  /// VAT on this line in Rial; 0 for exempt goods.
  taxAmount       Int  @default(0)

  returnItems return_request_item[]

  @@index([orderId])
  @@index([variantId])
}

/// One online payment attempt. Client `idempotencyKey` is unique so retries
/// return the same intent; gateway callbacks are matched by `gatewayRef`.
model payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  idempotencyKey String        @unique
  gatewayRef     String?       @unique
  amount         Int
  status         PaymentStatus @default(INITIATED)
  failureReason  String?
  redirectUrl    String?

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  tracks payment_gateway_ref[]

  @@index([orderId, status])
}

/// Every Zibal trackId issued for a payment, including ones replaced after a
/// Failed retry, so a late callback on the old tab can still settle.
model payment_gateway_ref {
  gatewayRef String   @id
  paymentId  Int
  payment    payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Comments
//
// Product discussion with one level of replies. Customer posts stay hidden
// until an admin approves them (`published = false` by default). Admin posts
// and replies go live immediately. Images live in `comment_image` and on disk
// under uploads/comments/.
// ---------------------------------------------------------------------------

model comment {
  id        Int     @id @default(autoincrement())
  title     String?
  content   String  @db.Text
  /// Optional 1–5 product rating. Only meaningful on root comments.
  rate      Int?
  published Boolean @default(false)

  productId Int
  product   product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Exactly one of userId / adminId is set — who wrote the comment.
  userId  Int?
  user    user?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId Int?
  admin   admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  comment[] @relation("CommentReplies")

  images comment_image[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([productId, published, created_at])
  @@index([userId, created_at])
  @@index([parentId])
  @@index([published, created_at])
}

model comment_image {
  id        Int     @id @default(autoincrement())
  commentId Int
  comment   comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  position  Int     @default(0)

  created_at DateTime @default(now())

  @@index([commentId, position])
}

// ---------------------------------------------------------------------------
// Notifications
//
// In-app inbox for customers and admins. Other bounded contexts call
// `Notifications.sendNotification` with a context + type; this module fans
// out to recipients (a user, an admin, or every active admin).
// ---------------------------------------------------------------------------

enum NotificationAudience {
  USER
  ADMIN
}

model notification {
  id Int @id @default(autoincrement())

  audience    NotificationAudience
  /// user.id when audience is USER; admin.id when audience is ADMIN.
  recipientId Int

  /// Bounded context that produced the event, e.g. `ordering`.
  context String @db.VarChar(40)
  /// Event within that context, e.g. `order.created`.
  type    String @db.VarChar(80)

  title String
  body  String @db.Text
  data  Json?

  userId  Int?
  user    user?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId Int?
  admin   admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  readAt     DateTime?
  created_at DateTime  @default(now())

  @@index([audience, recipientId, created_at])
  @@index([audience, recipientId, readAt])
  @@index([context, type])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

/// A delivery option the customer picks at checkout. The fee is
/// base_fee + per_kg_fee for every started kilogram, or 0 when the basket
/// subtotal reaches free_above.
model shipping_method {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String? @db.Text

  /// Rial.
  base_fee   Int
  /// Rial per started kilogram of parcel weight.
  per_kg_fee Int  @default(0)
  /// Basket subtotal (Rial) at or above which shipping is free; null = never.
  free_above Int?

  min_days Int?
  max_days Int?

  /// Province ids served; null = every province.
  province_ids          Json?
  /// e.g. "https://tracking.post.ir/?id={code}"; {code} becomes the tracking code.
  tracking_url_template String? @db.Text

  is_active Boolean @default(true)
  position  Int     @default(0)

  orders order[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([is_active, position])
}

/// Append-only log of order status changes.
model order_status_event {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text

  created_at DateTime @default(now())

  @@index([orderId, created_at])
}

// ---------------------------------------------------------------------------
// Store settings, returns and refunds
// ---------------------------------------------------------------------------

/// One row (id = 1) of store-wide settings: VAT and the seller details printed on invoices.
model store_setting {
  id Int @id @default(1)

  /// Basis points: 1000 = 10%.
  vat_rate_bp        Int     @default(1000)
  /// Days after delivery during which customers may ask to return items.
  return_window_days Int     @default(7)
  legal_name         String?
  economic_code      String? @db.VarChar(20)
  national_id        String? @db.VarChar(20)
  registration_no    String? @db.VarChar(20)
  address            String? @db.Text
  postal_code        String? @db.VarChar(10)
  phone              String? @db.VarChar(20)

  updated_at DateTime @updatedAt
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

/// A customer's request to send back some lines of a delivered order.
model return_request {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  Int

  status    ReturnRequestStatus @default(REQUESTED)
  reason    String              @db.Text
  adminNote String?             @db.Text
  decidedAt DateTime?

  items   return_request_item[]
  refunds refund[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
  @@index([orderId])
}

model return_request_item {
  id              Int            @id @default(autoincrement())
  returnRequestId Int
  returnRequest   return_request @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     Int
  orderItem       order_item     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

/// Money paid back to a customer by bank transfer outside the system.
model refund {
  id              Int             @id @default(autoincrement())
  orderId         Int
  order           order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequestId Int?
  returnRequest   return_request? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  /// Rial.
  amount    Int
  /// Whether the returned lines went back into stock.
  restocked Boolean  @default(false)
  /// Bank transfer reference (shomare peygiri).
  reference String   @db.VarChar(100)
  note      String?  @db.Text
  paidAt    DateTime
  adminId   Int?

  created_at DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Promotions, stock movements, audit log
// ---------------------------------------------------------------------------

enum PromotionKind {
  PERCENT
  FIXED
  FREE_SHIPPING
}

/// A coupon (code set) or an automatic campaign (no code). An order gets at
/// most one promotion: the one worth the most.
model promotion {
  id                 Int           @id @default(autoincrement())
  name               String
  /// Uppercase coupon code; null for automatic campaigns.
  code               String?       @unique @db.VarChar(40)
  kind               PromotionKind
  /// PERCENT: whole percent 1-100. FIXED: Rial. FREE_SHIPPING: ignored.
  value              Int           @default(0)
  /// Cap for PERCENT discounts, Rial.
  max_discount       Int?
  /// Eligible subtotal (Rial) needed before the promotion applies.
  min_subtotal       Int?
  starts_at          DateTime
  ends_at            DateTime?
  /// Total redemptions allowed; null = unlimited.
  usage_limit        Int?
  /// Redemptions per customer; null = unlimited.
  per_customer_limit Int?
  /// Limit to products in these categories (and their sub-categories) or brands; null = all.
  category_ids       Json?
  brand_ids          Json?
  is_active          Boolean       @default(true)
  used_count         Int           @default(0)

  redemptions promotion_redemption[]
  orders      order[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([is_active, starts_at])
}

/// One use of a promotion by an order. Deleted when the order is cancelled.
model promotion_redemption {
  id          Int       @id @default(autoincrement())
  promotionId Int
  promotion   promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId     Int       @unique
  order       order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      Int
  /// Rial.
  amount      Int

  created_at DateTime @default(now())

  @@index([promotionId, userId])
}

/// Manual on-hand change by an admin, with the reason.
model stock_movement {
  id          Int             @id @default(autoincrement())
  variantId   Int
  variant     product_variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId  Int
  /// Positive adds units, negative removes them.
  delta       Int
  onHandAfter Int
  reason      String          @db.VarChar(255)
  adminId     Int?

  created_at DateTime @default(now())

  @@index([variantId, created_at])
}

/// Every back-office change: who, what, and the request that did it.
model admin_audit_log {
  id       Int     @id @default(autoincrement())
  adminId  Int?
  admin    admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// e.g. "POST /admin/orders/:id/refunds"
  action   String  @db.VarChar(191)
  /// Resource and id taken from the route, e.g. orders / 42.
  entity   String  @db.VarChar(64)
  entityId String? @db.VarChar(64)
  /// Request body with secrets removed.
  payload  Json?
  /// HTTP status of the result.
  status   Int

  created_at DateTime @default(now())

  @@index([adminId, created_at])
  @@index([entity, entityId])
  @@index([created_at])
}

// ---------------------------------------------------------------------------
// SEO
// ---------------------------------------------------------------------------

enum SlugRedirectType {
  PRODUCT
  CATEGORY
  BRAND
}

/// A slug a catalog entry used to have. Old links resolve to the entry's
/// current slug by id, so renaming twice still lands on the latest one.
model slug_redirect {
  id       Int              @id @default(autoincrement())
  type     SlugRedirectType
  old_slug String
  /// Product, category or brand id (no foreign key: the table is shared).
  targetId Int

  created_at DateTime @default(now())

  @@unique([type, old_slug])
  @@index([type, targetId])
}

// ---------------------------------------------------------------------------
// Back-in-stock alerts
// ---------------------------------------------------------------------------

/// A customer asked for an SMS when an out-of-stock variant can be bought again.
/// Sent once; asking again after notification starts a new wait.
model stock_alert {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId Int
  variant   product_variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  created_at  DateTime  @default(now())
  /// Set when the SMS went out.
  notified_at DateTime?

  @@unique([userId, variantId])
  @@index([variantId, notified_at])
}

/// Login codes when Redis is not available (serverless hosts). One row per phone.
model otp_challenge {
  phone_number String   @id @db.VarChar(20)
  code         String   @db.VarChar(10)
  expires_at   DateTime

  @@index([expires_at])
}
